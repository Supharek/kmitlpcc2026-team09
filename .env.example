# ---------------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง  (.env.local ห้าม commit เด็ดขาด)
# ค่าเดียวกันนี้ต้องไปตั้งใน Vercel > Project > Settings > Environment Variables
# ---------------------------------------------------------------------------

# Supabase (เอาจาก Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role key = สิทธิ์เต็ม ข้าม RLS ทั้งหมด
# ใช้ได้เฉพาะใน Route Handler (ฝั่ง server) เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ข้อมูลบริษัทที่แสดงบนเว็บ
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=ชื่อบริษัทของทีม
